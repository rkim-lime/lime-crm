{
  "name": "lime-crm-ingestion",
  "version": "0.1.0",
  "description": "Standalone data ingestion service for Lime CRM — SEC 13F filings",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "ingest:13f": "node src/index.js ingest-13f",
    "ingest:13f:test": "node src/index.js ingest-13f --limit 5",
    "worker": "node src/index.js worker",
    "worker:once": "node src/index.js worker --once",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cron-parser": "^4.9.0",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "^4.3.3",
    "luxon": "^3.4.4",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.9"
  }
}
