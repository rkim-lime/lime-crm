# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it contains the service_role key.

# Supabase project URL (from Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# service_role key — bypasses RLS. Keep secret, never expose to frontend.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SEC EDGAR requires a User-Agent header identifying your app and a contact email.
# Format: "AppName/1.0 (contact@example.com)"
# Without this, EDGAR returns 403.
SEC_USER_AGENT=LimeCRM-Ingestion/1.0 (you@yourdomain.com)

# Optional: enable verbose debug logging
# DEBUG=true
